# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3000
WS_PORT=3001
NODE_ENV=production

# ── Session Secret ──────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=ganti_dengan_random_string_panjang

# ── Auth ────────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD_PLAIN=ganti_password_kuat_disini

# ── Database (local postgres container) ─────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=ganti_password_postgres
POSTGRES_DB=agv_db
DATABASE_URL=postgresql://user:ganti_password_postgres@postgres:5432/agv_db
DB_SSL=false

# ── MQTT (local mosquitto container) ────────────────────────────────────────────
MQTT_BROKER=mqtt://mosquitto:1883

# ── CORS ────────────────────────────────────────────────────────────────────────
# Ganti dengan IP/domain VPS kamu
ALLOWED_ORIGIN=http://208.76.40.195:3000
