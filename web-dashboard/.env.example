# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3000
WS_PORT=3001
NODE_ENV=production

# ── Session Secret ──────────────────────────────────────────────────────────────
# Generate a random string for production, e.g. with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_super_secret_session_key_here

# ── Auth ────────────────────────────────────────────────────────────────────────
# Set INITIAL plain password for setup.
# IMPORTANT: Remove ADMIN_PASSWORD_PLAIN after first run and rely on hash in DB!
ADMIN_USERNAME=1
ADMIN_PASSWORD_PLAIN=1

# ── Database ────────────────────────────────────────────────────────────────────
# Use local Postgres container by default
DATABASE_URL=postgresql://user:password@postgres:5432/agv_db
# Or use NeonDB / external Postgres:
# DATABASE_URL=postgresql://neondb_owner:password@.../neondb?sslmode=require&channel_binding=require

# ── MQTT ────────────────────────────────────────────────────────────────────────
# Use local Mosquitto container by default
MQTT_BROKER=mqtt://mosquitto:1883
# Or use external like HiveMQ:
# MQTT_BROKER=mqtt://broker.hivemq.com:1883

# ── CORS / Allowed Origins ──────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://0.0.0.0:3000

# 3D Folio / Simulation
# Ganti dengan URL Vercel folio setelah deploy, misalnya:
# FOLIO_URL=https://xora-folio.vercel.app
FOLIO_URL=http://localhost:5173

# Opsional untuk live telemetry read-only dari folio ke WebSocket dashboard.
# Samakan nilainya dengan VITE_FOLIO_PUBLIC_WS_TOKEN di Vercel.
FOLIO_PUBLIC_WS_TOKEN=
